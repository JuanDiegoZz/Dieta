{
  "name": "dieta-personal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:vite": "vite",
    "build": "pnpm typecheck && vite build",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.app.json --noEmit --pretty false && tsc -p tsconfig.node.json --noEmit --pretty false && tsc -p tsconfig.scripts.json --noEmit --pretty false",
    "typecheck:vercel": "tsc -p tsconfig.vercel.json --noEmit --pretty false",
    "test": "vitest run",
    "verify": "tsx --env-file=.env.local scripts/verify.ts",
    "smoke:api": "tsx scripts/smoke-local-api.ts",
    "diet:parse": "tsx scripts/diet/parse.ts",
    "diet:validate": "tsx scripts/diet/validate.ts",
    "diet:import": "tsx --env-file=.env.local scripts/diet/import.ts",
    "diet:audit": "tsx --env-file=.env.local scripts/diet/repair.ts --dry-run",
    "diet:repair": "tsx --env-file=.env.local scripts/diet/repair.ts"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-legacy": "^7.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.36.0",
    "globals": "^16.4.0",
    "jszip": "^3.10.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
